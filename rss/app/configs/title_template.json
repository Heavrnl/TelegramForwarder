{
    "patterns": [
      {
        "pattern": "^(?:#\\S+\\s*)+\\n\\s*\\n([^\\n]+)",
        "description": "Title after first line of all tags: #tag1 #tag2\\n\\nTitle content"
      },
      {
        "pattern": "^#[^\\s]+\\s+\\*\\*([^\\*]+?)\\*\\*",
        "description": "Bold title with tag: #tag **Title**"
      },
      {
        "pattern": "^#[^\\s]+\\s+(.+?)(?=\\n|$)",
        "description": "Title with tag: #tag Title content"
      },
      {
        "pattern": "^\\[\\*\\*([^\\*]+?)\\*\\*\\]\\([^\\)]+?\\)",
        "description": "Bold title with link: [**Title**](link)"
      },
      {
        "pattern": "^\\[([^\\]]+?)\\]\\([^\\)]+?\\)",
        "description": "Title with link: [Title](link)"
      },
      {
        "pattern": "^\\*\\*([^\\*]+?)\\*\\*",
        "description": "Bold title: **Title**"
      },
      {
        "pattern": "^【([^】]+?)】",
        "description": "Chinese bracket title: 【Title】"
      },
      {
        "pattern": "^\\[([^\\]]+?)\\]",
        "description": "Square bracket title: [Title]"
      },
      {
        "pattern": "^(.+?)\\n",
        "description": "First line as title"
      }
    ]
  }
